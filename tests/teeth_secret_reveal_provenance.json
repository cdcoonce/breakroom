{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "pytest",
    "-q",
    "tests/test_secrets.py::test_reveal_provenance_has_stable_norm_arrays_with_or_without_registry"
  ],
  "collect_command": [
    "uv",
    "run",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_secrets.py::test_reveal_provenance_has_stable_norm_arrays_with_or_without_registry"
  ],
  "mutants": [
    {
      "label": "omit required norm_tags provenance",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "        \"norm_tags\": [],\n",
      "replace": ""
    },
    {
      "label": "omit required norm_violations provenance",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "        \"norm_violations\": [],\n",
      "replace": ""
    },
    {
      "label": "restore optional-registry-dependent provenance shape",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "        \"norm_tags\": [],\n        \"norm_violations\": [],\n",
      "replace": "        **(\n            {\"norm_tags\": [], \"norm_violations\": []}\n            if (world / \"data\" / \"norms.toml\").exists()\n            else {}\n        ),\n"
    },
    {
      "label": "parse an optional norms registry during secret reveal",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "    provenance: dict[str, Any] = {",
      "replace": "    if (world / \"data\" / \"norms.toml\").exists():\n        from breakroom import norms\n\n        norms.load_registry(world)\n    provenance: dict[str, Any] = {"
    },
    {
      "label": "[control] reorder independent provenance entries",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "expect": "survived",
      "why": "Provenance is a mapping and event JSON is serialized with sorted keys, so source insertion order of these independent fields does not change the event or its decoded value in either test case.",
      "find": "        \"trigger\": \"exposure_threshold\",\n        \"exposure_risk\": exposure_risk,",
      "replace": "        \"exposure_risk\": exposure_risk,\n        \"trigger\": \"exposure_threshold\","
    }
  ]
}

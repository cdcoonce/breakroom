{
  "runner": "pytest",
  "test_command": [
    "uv",
    "run",
    "pytest",
    "-q",
    "tests/test_secrets.py::test_advance_exposure_draws_are_bound_to_the_secret_id"
  ],
  "collect_command": [
    "uv",
    "run",
    "pytest",
    "--collect-only",
    "-q",
    "tests/test_secrets.py::test_advance_exposure_draws_are_bound_to_the_secret_id"
  ],
  "mutants": [
    {
      "label": "reuse shared exposure stream across secret IDs",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "rng = RngStream(seed=seed, stream=f\"exposure:{secret.id}\", tick=tick)",
      "replace": "rng = RngStream(seed=seed, stream=\"exposure\", tick=tick)"
    },
    {
      "label": "share exposure streams between secrets of the same holder",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "rng = RngStream(seed=seed, stream=f\"exposure:{secret.id}\", tick=tick)",
      "replace": "rng = RngStream(seed=seed, stream=f\"exposure:{secret.holder}\", tick=tick)"
    },
    {
      "label": "[control] change the recorded exposure draw purpose",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "expect": "survived",
      "why": "RngStream.uniform records the purpose label but draws from a generator seeded only by seed, stream, and tick, so renaming this label leaves the exposure result unchanged on all paths; this control says nothing about changing the stream identity or draw order.",
      "find": "risk = _clamp(risk + delta * rng.uniform(f\"delta:{index}\"))",
      "replace": "risk = _clamp(risk + delta * rng.uniform(f\"exposure-delta:{index}\"))"
    }
  ]
}

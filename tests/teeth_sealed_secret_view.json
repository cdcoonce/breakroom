{
  "runner": "pytest",
  "test_command": [
    "uv", "run", "pytest", "-q", "tests/test_secrets.py", "-k", "public_views_hide_truth"
  ],
  "collect_command": [
    "uv", "run", "pytest", "--collect-only", "-q", "tests/test_secrets.py", "-k",
    "public_views_hide_truth"
  ],
  "mutants": [
    {
      "label": "sealed truth remains public",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "            record.pop(\"is_true\")\n",
      "replace": "            record[\"is_true\"] = self.is_true\n"
    },
    {
      "label": "observable truth is removed",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "        return record\n",
      "replace": "        record.pop(\"is_true\", None)\n        return record\n"
    },
    {
      "label": "observable false truth becomes true",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "        return record\n",
      "replace": "        if self.state == \"observable\":\n            record[\"is_true\"] = True\n        return record\n"
    },
    {
      "label": "sealed knowers are removed",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "            record.pop(\"is_true\")\n",
      "replace": "            record.pop(\"is_true\")\n            record.pop(\"knowers\")\n"
    },
    {
      "label": "sealed exposure risk is removed",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "find": "            record.pop(\"is_true\")\n",
      "replace": "            record.pop(\"is_true\")\n            record.pop(\"exposure_risk\")\n"
    },
    {
      "label": "[control] explain the existing redaction",
      "file": "../src/breakroom/secrets.py",
      "oracle": "real",
      "expect": "survived",
      "why": "A Python comment before the unchanged redaction has no runtime effect on either public API, record, or store.",
      "find": "            record.pop(\"is_true\")\n",
      "replace": "            # Truth follows the sealed content boundary.\n            record.pop(\"is_true\")\n"
    }
  ]
}
